{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "types": [
            "@types/jest",
            "@types/node"
        ],
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    }
}